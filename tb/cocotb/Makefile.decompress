# cocotb Makefile for sisDecompress tests
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(shell pwd)/../../rtl/core/sisDecompress.sv
TOPLEVEL = sisDecompress
MODULE = test_decompress
SIM ?= verilator

# Match other cocotb unit Makefiles / top-level Verilator build: width
# warnings in RV32C bit-scrambling are intentional and otherwise fail -Wall.
EXTRA_ARGS += --timing -Wno-WIDTHEXPAND -Wno-WIDTHTRUNC
ifeq ($(COVERAGE),1)
EXTRA_ARGS += --coverage
endif

include $(shell cocotb-config --makefiles)/Makefile.sim
